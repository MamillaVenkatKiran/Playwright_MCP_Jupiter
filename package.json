{
  "name": "jupiter-toys-e2e",
  "version": "1.0.0",
  "description": "Playwright automation tests for Jupiter Toys",
  "main": "index.js",
  "scripts": {
    "test": "cd jupiter-toys/e2e && npx playwright test",
    "test:headed": "cd jupiter-toys/e2e && npx playwright test --headed",
    "test:ui": "cd jupiter-toys/e2e && npx playwright test --ui",
    "test:debug": "cd jupiter-toys/e2e && npx playwright test --debug",
    "test:chromium": "cd jupiter-toys/e2e && npx playwright test --project=chromium",
    "test:firefox": "cd jupiter-toys/e2e && npx playwright test --project=firefox",
    "test:webkit": "cd jupiter-toys/e2e && npx playwright test --project=webkit",
    "allure:report": "cd jupiter-toys/e2e && npx allure generate allure-results --clean -o allure-report",
    "allure:show": "cd jupiter-toys/e2e && npx allure open allure-report"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "allure-commandline": "^2.25.0",
    "allure-playwright": "^2.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "playwright-mcp": "^0.0.19"
  }
}
